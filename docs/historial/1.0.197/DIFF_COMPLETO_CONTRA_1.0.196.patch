+        FROM AlumnoInscripciones AI
+        JOIN CiclosEscolares C ON C.Id = AI.CicloId
+        JOIN Grupos G ON G.Id = AI.GrupoId AND G.CicloId = AI.CicloId
+        WHERE AI.AlumnoId = ? $WhereCiclo
