+#!/usr/bin/env python3
+import sqlite3
+from collections import defaultdict
+
+class CountingConnection:
+    def __init__(self, conn):
+        self.conn = conn
+        self.query_count = 0
+        self.queries = []
+    def execute(self, sql, params=()):
+        self.query_count += 1
+        normalized = ' '.join(sql.split())
+        self.queries.append(normalized)
+        return self.conn.execute(sql, params)
+    def executemany(self, sql, seq):
+        return self.conn.executemany(sql, seq)
+    def executescript(self, sql):
+        return self.conn.executescript(sql)
+
+
+def setup_db():
+    raw = sqlite3.connect(':memory:')
+    raw.row_factory = sqlite3.Row
+    db = CountingConnection(raw)
+    raw.executescript('''
+    CREATE TABLE Alumnos (Id INTEGER PRIMARY KEY, NombreCompleto TEXT);
+    CREATE TABLE CiclosEscolares (Id INTEGER PRIMARY KEY, Nombre TEXT, FechaInicio TEXT);
+    CREATE TABLE Grupos (Id INTEGER PRIMARY KEY, CicloId INTEGER, Grado TEXT, Grupo TEXT, Turno TEXT, OfertaId INTEGER);
+    CREATE TABLE AlumnoInscripciones (AlumnoId INTEGER, CicloId INTEGER, GrupoId INTEGER, Estado TEXT);
+    CREATE TABLE PeriodosEvaluacion (Id INTEGER PRIMARY KEY, CicloId INTEGER, OfertaId INTEGER, Nombre TEXT, Orden INTEGER, Activo INTEGER);
+    CREATE TABLE Usuarios (Id INTEGER PRIMARY KEY, NombreCompleto TEXT);
+    CREATE TABLE Asignaciones (Id INTEGER PRIMARY KEY, CicloId INTEGER, GrupoId INTEGER, MateriaNombre TEXT, MaestroId INTEGER);
+    CREATE TABLE Calificaciones (AlumnoId INTEGER, AsignacionId INTEGER, PeriodoId INTEGER, Calificacion REAL);
+    ''')
+    raw.execute('INSERT INTO Alumnos VALUES (?, ?)', (1, 'ALUMNO PRUEBA KARDEX'))
+    raw.execute('INSERT INTO Usuarios VALUES (?, ?)', (1, 'DOCENTE PRUEBA'))
+    aid = 1
+    pid = 1
+    for ciclo in range(1, 4):
+        raw.execute('INSERT INTO CiclosEscolares VALUES (?, ?, ?)', (ciclo, f'CICLO 202{ciclo}-202{ciclo+1}', f'202{ciclo}-08-01'))
+        gid = ciclo
+        raw.execute('INSERT INTO Grupos VALUES (?, ?, ?, ?, ?, ?)', (gid, ciclo, f'{ciclo}', 'A', 'MATUTINO', 1))
+        raw.execute('INSERT INTO AlumnoInscripciones VALUES (?, ?, ?, ?)', (1, ciclo, gid, 'INSCRITO'))
+        for orden in range(1, 4):
+            raw.execute('INSERT INTO PeriodosEvaluacion VALUES (?, ?, ?, ?, ?, ?)', (pid, ciclo, 1, f'PARCIAL {orden}', orden, 1))
+            pid += 1
+        for materia in ('ESPAÑOL', 'MATEMÁTICAS'):
+            raw.execute('INSERT INTO Asignaciones VALUES (?, ?, ?, ?, ?)', (aid, ciclo, gid, materia, 1))
+            for periodo_id in range((ciclo - 1) * 3 + 1, (ciclo - 1) * 3 + 4):
+                raw.execute('INSERT INTO Calificaciones VALUES (?, ?, ?, ?)', (1, aid, periodo_id, 8.0 + ciclo / 10.0))
+            aid += 1
+    raw.commit()
+    return db
+
+
+def kardex_report(db, alumno_id=1, ciclo_id=0):
+    alumno = db.execute('SELECT Id, NombreCompleto FROM Alumnos WHERE Id = ? LIMIT 1', (alumno_id,)).fetchone()
+    if not alumno:
+        raise RuntimeError('Alumno no encontrado')
+    where_ciclo = ' AND AI.CicloId = ? ' if ciclo_id > 0 else ''
+    params = [alumno_id] + ([ciclo_id] if ciclo_id > 0 else [])
+    ciclos = db.execute(f'''SELECT AI.CicloId, AI.GrupoId, AI.Estado, C.Nombre AS CicloNombre, C.FechaInicio, G.Grado, G.Grupo, G.Turno, G.OfertaId
+        FROM AlumnoInscripciones AI
+        JOIN CiclosEscolares C ON C.Id = AI.CicloId
+        JOIN Grupos G ON G.Id = AI.GrupoId AND G.CicloId = AI.CicloId
+        WHERE AI.AlumnoId = ? {where_ciclo}
+        ORDER BY C.FechaInicio ASC, C.Id ASC''', params).fetchall()
+
+    clauses_periodos, params_periodos, seen = [], [], set()
+    for c in ciclos:
+        key = (c['CicloId'], c['OfertaId'])
+        if key in seen: continue
+        seen.add(key); clauses_periodos.append('(CicloId = ? AND OfertaId = ?)'); params_periodos.extend(key)
+    periodos_by = defaultdict(list); period_ids = []
+    if clauses_periodos:
+        periodos = db.execute('SELECT Id, Nombre, Orden, CicloId, OfertaId FROM PeriodosEvaluacion WHERE (' + ' OR '.join(clauses_periodos) + ') AND Activo = 1 ORDER BY CicloId ASC, OfertaId ASC, Orden ASC, Id ASC', params_periodos).fetchall()
+        for p in periodos:
+            periodos_by[(p['CicloId'], p['OfertaId'])].append(p); period_ids.append(p['Id'])
+
+    clauses_asig, params_asig, seen = [], [], set()
+    for c in ciclos:
+        key = (c['CicloId'], c['GrupoId'])
+        if key in seen: continue
+        seen.add(key); clauses_asig.append('(A.CicloId = ? AND A.GrupoId = ?)'); params_asig.extend(key)
+    asig_by = defaultdict(list); asig_ids = []
+    if clauses_asig:
+        asignaciones = db.execute('SELECT A.Id, A.CicloId, A.GrupoId, A.MateriaNombre, U.NombreCompleto AS Maestro FROM Asignaciones A LEFT JOIN Usuarios U ON U.Id = A.MaestroId WHERE ' + ' OR '.join(clauses_asig) + ' ORDER BY A.CicloId ASC, A.GrupoId ASC, A.MateriaNombre ASC', params_asig).fetchall()
+        for a in asignaciones:
+            asig_by[(a['CicloId'], a['GrupoId'])].append(a); asig_ids.append(a['Id'])
+
+    cal_by = defaultdict(dict)
+    if period_ids and asig_ids:
+        marks_p = ','.join('?' for _ in period_ids)
+        marks_a = ','.join('?' for _ in asig_ids)
+        cals = db.execute(f'SELECT AsignacionId, PeriodoId, Calificacion FROM Calificaciones WHERE AlumnoId = ? AND AsignacionId IN ({marks_a}) AND PeriodoId IN ({marks_p})', [alumno_id] + asig_ids + period_ids).fetchall()
+        for c in cals:
+            cal_by[c['AsignacionId']][c['PeriodoId']] = c['Calificacion']
+
+    rows = []
+    for c in ciclos:
+        for a in asig_by[(c['CicloId'], c['GrupoId'])]:
+            rows.append((c['CicloNombre'], a['MateriaNombre'], [cal_by[a['Id']].get(p['Id']) for p in periodos_by[(c['CicloId'], c['OfertaId'])]]))
+    return {'cycles': len(ciclos), 'rows': len(rows), 'query_count': db.query_count, 'queries': db.queries}
+
+if __name__ == '__main__':
+    db = setup_db()
+    result = kardex_report(db)
+    print('KARDEX_SQLITE_QUERY_COUNT=' + str(result['query_count']))
+    print('KARDEX_CICLOS=' + str(result['cycles']))
+    print('KARDEX_FILAS=' + str(result['rows']))
+    for i, q in enumerate(result['queries'], 1):
+        print(f'Q{i}: {q}')
+    assert result['cycles'] == 3
+    assert result['rows'] == 6
+    assert result['query_count'] == 5
+    print('RESULTADO: KARDEX 3 CICLOS SIN N+1 OK')
